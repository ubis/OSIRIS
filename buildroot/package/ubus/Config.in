config BR2_PACKAGE_UBUS
	bool "ubus"
	depends on !BR2_PREFER_STATIC_LIB
	select BR2_PACKAGE_LIBUBOX
	select BR2_PACKAGE_JSON_C
	help
	  OpenWrt's micro bus architecture: the ubusd message bus
	  daemon, the libubus client library and the ubus command
	  line tool.

	  https://git.openwrt.org/project/ubus.git

comment "ubus needs a toolchain w/ dynamic library"
	depends on BR2_PREFER_STATIC_LIB
