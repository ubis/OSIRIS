[PATCH] audio_pipe: keep one descriptor for the pipe

start() opened the pipe again for every play session and dropped the
descriptor it had, while stop() leaves it open on purpose, so each
session leaked one. Open it only when none is open, and when the reader
has gone (EPIPE) close it, so the next write opens it again.
---
 audio_pipe.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

--- a/audio_pipe.c
+++ b/audio_pipe.c
@@ -52,7 +52,8 @@
   // "ENXIO  O_NONBLOCK | O_WRONLY is set, the named file is a FIFO, and no process has the FIFO
   // open for reading."
 
-  fd = try_to_open_pipe_for_writing(pipename);
+  if (fd == -1)
+    fd = try_to_open_pipe_for_writing(pipename);
   // we check that it's not a "real" error. From the "man 2 open" page:
   // "ENXIO  O_NONBLOCK | O_WRONLY is set, the named file is a FIFO, and no process has the FIFO
   // open for reading." Which is okay.
@@ -76,7 +77,10 @@
   if (fd > 0) {
     // int rc = non_blocking_write(fd, buf, samples * 4);
     int rc = write(fd, buf, samples * 4);
-    if ((rc < 0) && (errno != EPIPE)) {
+    if ((rc < 0) && (errno == EPIPE)) {
+      close(fd);
+      fd = -1;
+    } else if (rc < 0) {
       strerror_r(errno, (char *)errorstring, 1024);
       debug(1, "audio_pip play: error %d writing to the pipe named \"%s\": \"%s\".", errno,
             pipename, errorstring);
