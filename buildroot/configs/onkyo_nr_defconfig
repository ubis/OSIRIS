# Onkyo TX-NR515/717 (DA830 / OMAP-L137 ARM926EJ-S) userspace for the 2.6.33 kernel
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y

# uClibc toolchain against the kernel the receivers run
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="2.6.33"
BR2_TOOLCHAIN_BUILDROOT_LARGEFILE=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_BUILDROOT_INET_IPV6=y

BR2_TARGET_GENERIC_HOSTNAME="ONKYO"
BR2_TARGET_GENERIC_ISSUE="OSIRIS"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS1"
BR2_TARGET_GENERIC_ROOT_PASSWD="osiris"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# busybox: + ntpd, syslogd ring buffer and logread
BR2_PACKAGE_BUSYBOX_CONFIG="board/onkyo/nr/busybox.config"

# remote access
BR2_PACKAGE_DROPBEAR=y

# NAND / UBI maintenance
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_FLASH_ERASE=y
BR2_PACKAGE_MTD_NANDDUMP=y
BR2_PACKAGE_MTD_NANDWRITE=y
BR2_PACKAGE_MTD_UBIATTACH=y
BR2_PACKAGE_MTD_UBIDETACH=y
BR2_PACKAGE_MTD_UBIFORMAT=y
BR2_PACKAGE_MTD_UBIMKVOL=y
BR2_PACKAGE_MTD_UBIRMVOL=y
BR2_PACKAGE_MTD_UBINFO=y
BR2_PACKAGE_MTD_UBIUPDATEVOL=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_MKENVIMAGE=y

# audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y

# OSIRIS
BR2_PACKAGE_MCUD=y
BR2_PACKAGE_DSPD=y
BR2_PACKAGE_DSPAUDIO=y
BR2_ROOTFS_OVERLAY="board/onkyo/nr/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/onkyo/nr/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/onkyo/nr/post-image.sh"
BR2_PACKAGE_OVERRIDE_FILE="$(TOPDIR)/board/onkyo/nr/local.mk"

# kernel and boot loader from this repository's linux/ and u-boot/ trees
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_LOCAL=y
BR2_LINUX_KERNEL_CUSTOM_LOCAL_PATH="$(TOPDIR)/../linux"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="onkyo_nr"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BOARDNAME="da830evm"
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2009.11"
BR2_TARGET_UBOOT_FORMAT_BIN=y

# images: squashfs (gzip: 2.6.33 reads no LZO/XZ squashfs) and an initramfs for testing
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
