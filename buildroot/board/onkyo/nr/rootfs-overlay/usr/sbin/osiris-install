#!/bin/sh
#
# osiris-install: put OSIRIS on the NAND of an Onkyo receiver, from the
# installer system running in RAM (installer kernel booted over TFTP).
#
#   osiris-install [-s server]
#
# Fetches from the TFTP server (default: the boot server from ip=):
#   osiris-u-boot.dbi  osiris-uImage  osiris-rootfs.squashfs
# and writes:
#   uboot_a, uboot_b  U-Boot as a dspboot image (ROM-compatible hardware ECC)
#   ubi               kernel_a/b, rootfs_a/b and an empty data volume
#   env, env2         a fresh U-Boot environment: bootslot=a, the board's
#                     MAC address (ethaddr) and ip= of this boot kept
# dspboot (block 1) is left alone. Everything else on the NAND is erased.
#
set -e

ENV_TXT=/usr/share/osiris/u-boot-env.txt
KERNEL_VOL_SIZE=4MiB
ROOTFS_VOL_SIZE=12MiB

die() { echo "osiris-install: $*" >&2; exit 1; }
mtd() { sed -n "s/^mtd\([0-9]*\): .* \"$1\"\$/\1/p" /proc/mtd; }
md5() { md5sum | cut -d' ' -f1; }

server=$(sed -n 's/.* ip=[^:]*:\([^: ]*\).*/\1/p' /proc/cmdline)
[ "$1" = "-s" ] && server=$2
[ -n "$server" ] || die "no TFTP server, use -s <ip>"
grep -q "osiris.slot=" /proc/cmdline && die "running from NAND; boot the installer kernel"

ENV=$(mtd env); ENV2=$(mtd env2); UBOOT_A=$(mtd uboot_a); UBOOT_B=$(mtd uboot_b); UBI=$(mtd ubi)
[ -n "$ENV" ] && [ -n "$ENV2" ] && [ -n "$UBOOT_A" ] && [ -n "$UBOOT_B" ] && [ -n "$UBI" ] ||
	die "OSIRIS flash partitions not found in /proc/mtd (old kernel?)"

mac=$(osiris-ethaddr) || die "no MAC address (ethaddr) in the U-Boot environment"
ipargs=$(tr ' ' '\n' < /proc/cmdline | grep '^ip=' || true)
echo "MAC $mac, server $server${ipargs:+, keeping $ipargs}"

cd /tmp
for f in osiris-u-boot.dbi osiris-uImage osiris-rootfs.squashfs; do
	echo "fetching $f"
	tftp -g -r $f -l $f $server || die "tftp $f failed"
done
[ "$(head -c 4 osiris-u-boot.dbi)" = "DBI1" ] || die "osiris-u-boot.dbi is not a dspboot image"

len=$(wc -c < osiris-u-boot.dbi)
want=$(md5 < osiris-u-boot.dbi)
for m in $UBOOT_A $UBOOT_B; do
	echo "writing U-Boot to mtd$m"
	flash_erase -q /dev/mtd$m 0 0
	nandwrite -q -p /dev/mtd$m osiris-u-boot.dbi
	nanddump -q -l $len -f /tmp/check /dev/mtd$m
	[ "$(head -c $len /tmp/check | md5)" = "$want" ] || die "U-Boot read-back differs on mtd$m"
done
rm -f /tmp/check

echo "creating UBI on mtd$UBI"
ubidetach -m $UBI > /dev/null 2>&1 || true
ubiformat -q -y /dev/mtd$UBI
ubiattach -m $UBI -d 0 > /dev/null
ubimkvol /dev/ubi0 -n 0 -N kernel_a -s $KERNEL_VOL_SIZE > /dev/null
ubimkvol /dev/ubi0 -n 1 -N kernel_b -s $KERNEL_VOL_SIZE > /dev/null
ubimkvol /dev/ubi0 -n 2 -N rootfs_a -s $ROOTFS_VOL_SIZE > /dev/null
ubimkvol /dev/ubi0 -n 3 -N rootfs_b -s $ROOTFS_VOL_SIZE > /dev/null
ubimkvol /dev/ubi0 -n 4 -N data -m > /dev/null
for v in 0 1; do ubiupdatevol /dev/ubi0_$v osiris-uImage; done
for v in 2 3; do ubiupdatevol /dev/ubi0_$v osiris-rootfs.squashfs; done
ubinfo -d 0 -a | sed -n 's/^Name: *//p' | tr '\n' ' '; echo

echo "writing the U-Boot environment"
{ grep -v '^bootargs_extra=' $ENV_TXT; echo "bootargs_extra=$ipargs"; echo "ethaddr=$mac"; } > /tmp/env.txt
mkenvimage -r -s 0x4000 -o /tmp/env.bin /tmp/env.txt
for m in $ENV $ENV2; do
	flash_erase -q /dev/mtd$m 0 0
	nandwrite -q -p /dev/mtd$m /tmp/env.bin
done
[ "$(fw_printenv -n ethaddr)" = "$mac" ] || die "environment does not read back"
fw_printenv bootslot

echo "done: reboot to start OSIRIS from NAND"
