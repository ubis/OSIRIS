# Linux kernel style for C: tabs, shown 8 wide
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{c,h,S,ld}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80

[Makefile]
indent_style = tab
tab_width = 8

[*.py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = tab
tab_width = 8
