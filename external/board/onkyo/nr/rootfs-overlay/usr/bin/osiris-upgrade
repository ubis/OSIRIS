#!/bin/sh
#
# osiris-upgrade: install an OSIRIS update bundle into the inactive slot and
# boot it once. If the new system comes up, /etc/init.d/confirm makes it the
# default slot; if it does not (panic, watchdog reset), the next boot is the
# old slot.
#
#   osiris-upgrade [-n] bundle.tar      -n: do not reboot afterwards
#
# A bundle (tools/mkbundle.sh) is a tar file with VERSION, md5sums, the
# kernel as kernel.itb (FIT) or uImage or both, rootfs.squashfs and
# optionally u-boot.dbi; the FIT is preferred. The running slot is not
# touched.
# The kernel and root file system are checked and written straight from the
# bundle, which may itself be in /tmp: there is no room for a second copy.
# The slot's volumes take the images' sizes, from the free space of the UBI.
#
set -e

die() { echo "osiris-upgrade: $*" >&2; exit 1; }
mtd() { sed -n "s/^mtd\([0-9]*\): .* \"$1\"\$/\1/p" /proc/mtd; }
vol() { ubinfo -d 0 -N $1 2> /dev/null | sed -n 's/^Volume ID: *\([0-9]*\).*/\1/p'; }
md5() { md5sum | cut -d' ' -f1; }
# same DEV FILE: the first size-of-FILE bytes of DEV match FILE
same() { [ "$(head -c $(wc -c < $2) $1 | md5)" = "$(md5 < $2)" ]; }
part() { tar -xOf "$bundle" $1; }
size() { tar -tvf "$bundle" $1 | awk '{ print $3 }'; }
sum() { sed -n "s/^\([0-9a-f]*\)  $1\$/\1/p" md5sums; }
ubi() { ubinfo -d 0 | sed -n "s/^$1: *\([0-9]*\).*/\1/p"; }
lebs() { ubinfo -d 0 -N $1 2> /dev/null | sed -n 's/^Size: *\([0-9]*\) LEBs.*/\1/p'; }

reboot=1
[ "$1" = "-n" ] && { reboot=0; shift; }
[ -f "$1" ] || die "usage: osiris-upgrade [-n] bundle.tar"
bundle=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")

cur=$(sed -n 's/.*osiris\.slot=\([ab]\).*/\1/p' /proc/cmdline)
[ -n "$cur" ] || die "not running from NAND (no osiris.slot= on the kernel command line)"
if [ $cur = a ]; then new=b; else new=a; fi

work=/tmp/osiris-upgrade
rm -rf $work
mkdir -p $work
cd $work
tar -tf "$bundle" > list || die "cannot read $bundle"
# the FIT only with a U-Boot for the slot: without one the slot keeps its
# U-Boot, which may be an older one that boots only a uImage
grep -qx kernel.itb list && grep -qx u-boot.dbi list && kernel=kernel.itb || kernel=uImage
for f in VERSION md5sums $kernel rootfs.squashfs; do
	grep -qx $f list || die "not an OSIRIS bundle"
done
grep -qx u-boot.dbi list && dbi=u-boot.dbi || dbi=
tar -xf "$bundle" VERSION md5sums $dbi || die "cannot unpack $bundle"
for f in $kernel rootfs.squashfs $dbi; do
	[ "$(part $f | md5)" = "$(sum $f)" ] || die "checksum mismatch, the bundle is damaged"
done
echo "running $(. /etc/os-release; echo $VERSION) in slot $cur, installing $(cat VERSION) into slot $new"

leb=$(ubi "Logical eraseblock size")
have=$(ubi "Amount of available logical eraseblocks")
need=0
for p in kernel:$kernel rootfs:rootfs.squashfs; do
	n=$(lebs ${p%%:*}_$new)
	[ -n "$n" ] || die "no UBI volume ${p%%:*}_$new"
	have=$((have + n))
	need=$((need + ($(size ${p#*:}) + leb - 1) / leb))
done
[ $need -le $have ] || die "the images need $need blocks of the UBI, $have are free"
# down to a block each first, so that one can grow into what the other gave up
for v in kernel_$new rootfs_$new; do
	ubirsvol /dev/ubi0 -N $v -s 1
done

for p in kernel:$kernel rootfs:rootfs.squashfs; do
	name=${p%%:*}_$new
	file=${p#*:}
	v=$(vol $name)
	n=$(size $file)
	echo "writing $file to $name"
	ubirsvol /dev/ubi0 -N $name -s $n
	part $file | ubiupdatevol -s $n /dev/ubi0_$v -
	[ "$(head -c $n /dev/ubi0_$v | md5)" = "$(sum $file)" ] || die "$name read-back differs"
done
if [ -f u-boot.dbi ]; then
	m=$(mtd uboot_$new)
	[ -n "$m" ] || die "no uboot_$new partition"
	[ "$(head -c 4 u-boot.dbi)" = "DBI1" ] || die "u-boot.dbi is not a dspboot image"
	echo "writing u-boot.dbi to uboot_$new"
	flash_erase -q /dev/mtd$m 0 0
	nandwrite -q -p /dev/mtd$m u-boot.dbi
	nanddump -q -l $(wc -c < u-boot.dbi) -f check /dev/mtd$m
	same check u-boot.dbi || die "uboot_$new read-back differs"
fi

fw_setenv upgrade_slot $new
cd /
rm -rf $work
echo "slot $new will be tried once on the next boot"
if [ $reboot = 1 ]; then
	echo "rebooting"
	reboot
fi
