#!/bin/sh
#
# osiris-upgrade: install an update bundle into the slot that is not running
# and boot it once; /etc/init.d/confirm keeps it if it comes up, otherwise
# the next boot is the old slot again
#
#   osiris-upgrade [-n] bundle.tar      -n: do not reboot
#
# The images are written straight from the bundle, which may itself be in
# /tmp, and checked by reading them back. Each pass reads the whole bundle,
# from a USB stick too, so there are few. The slot's volumes take the
# images' sizes.
#
set -e
. /usr/lib/osiris/functions.sh

# the bundle's files: their size, whether there, checksum, contents
size() { awk -v f=$1 '$6 == f { print $3 }' list; }
has() { [ -n "$(size $1)" ]; }
sum() { sed -n "s/^\([0-9a-f]*\)  $1\$/\1/p" md5sums; }
part() { tar -xOf "$bundle" $1; }
# vmd5 VOLUME N: md5 of a UBI volume's first N bytes, read a block at a time
# (in small reads, as head does them, it takes three times as long)
vmd5() {
	{
		dd bs=$leb count=$(($2 / leb)) 2> /dev/null
		[ $(($2 % leb)) = 0 ] || dd bs=$(($2 % leb)) count=1 2> /dev/null
	} < $1 | md5
}

# what to install, and its checksums
read_bundle() {
	local f

	tar -tvf "$bundle" > list || die "cannot read $bundle"
	for f in VERSION md5sums kernel.itb rootfs.squashfs; do
		has $f || die "not an OSIRIS bundle"
	done
	has u-boot.dbi && dbi=u-boot.dbi || dbi=
	tar -xf "$bundle" VERSION md5sums $dbi || die "cannot unpack $bundle"
	for f in kernel.itb rootfs.squashfs $dbi; do
		[ -n "$(sum $f)" ] || die "no checksum for $f"
	done
	[ -z "$dbi" ] || [ "$(md5 < $dbi)" = "$(sum $dbi)" ] ||
		die "checksum mismatch, the bundle is damaged"
	echo "running $(. /etc/os-release; echo $VERSION) in slot $cur, installing $(cat VERSION) into slot $new"
}

# the images fit into the slot's volumes and the free blocks; the volumes
# go down to a block each, so that one can grow into what the other gives up
make_room() {
	local p n v have=$(ubi_info "Amount of available logical eraseblocks") need=0

	leb=$(ubi_info "Logical eraseblock size")
	for p in kernel:kernel.itb rootfs:rootfs.squashfs; do
		n=$(ubi_info Size ${p%%:*}_$new)
		[ -n "$n" ] || die "no UBI volume ${p%%:*}_$new"
		have=$((have + n))
		need=$((need + ($(size ${p#*:}) + leb - 1) / leb))
	done
	[ $need -le $have ] || die "the images need $need blocks of the UBI, $have are free"
	for v in kernel_$new rootfs_$new; do
		ubirsvol /dev/ubi0 -N $v -s 1
	done
}

write_volumes() {
	local p name file v n

	for p in kernel:kernel.itb rootfs:rootfs.squashfs; do
		name=${p%%:*}_$new
		file=${p#*:}
		v=$(ubi_info "Volume ID" $name)
		n=$(size $file)
		echo "writing $file to $name"
		ubirsvol /dev/ubi0 -N $name -s $n
		part $file | ubiupdatevol -s $n /dev/ubi0_$v -
		[ "$(vmd5 /dev/ubi0_$v $n)" = "$(sum $file)" ] ||
			die "$name read-back differs from the bundle's checksum"
	done
}

write_uboot() {
	local m=$(mtd_index uboot_$new) n=$(wc -c < u-boot.dbi)

	[ -n "$m" ] || die "no uboot_$new partition"
	[ "$(head -c 4 u-boot.dbi)" = "DBI1" ] || die "u-boot.dbi is not a dspboot image"
	echo "writing u-boot.dbi to uboot_$new"
	flash_erase -q /dev/mtd$m 0 0
	nandwrite -q -p /dev/mtd$m u-boot.dbi
	nanddump -q -l $n -f check /dev/mtd$m
	[ "$(head -c $n check | md5)" = "$(md5 < u-boot.dbi)" ] || die "uboot_$new read-back differs"
}

reboot=1
[ "$1" = "-n" ] && { reboot=0; shift; }
[ -f "$1" ] || die "usage: osiris-upgrade [-n] bundle.tar"
bundle=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")

cur=$(boot_slot)
[ -n "$cur" ] || die "not running from NAND (no osiris.slot= on the kernel command line)"
if [ $cur = a ]; then new=b; else new=a; fi

work=/tmp/osiris-upgrade
rm -rf $work
mkdir -p $work
cd $work

read_bundle
make_room
write_volumes
[ -z "$dbi" ] || write_uboot
fw_setenv upgrade_slot $new
cd /
rm -rf $work
echo "slot $new will be tried once on the next boot"
if [ $reboot = 1 ]; then
	echo "rebooting"
	reboot
fi
