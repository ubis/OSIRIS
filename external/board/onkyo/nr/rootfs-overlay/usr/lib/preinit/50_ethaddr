# the MAC address from the U-Boot environment, set while eth0 runs if the
# kernel brought it up (ip=, installer): taken down, its link would not
# come back
mac=$(osiris-ethaddr)
if [ -z "$mac" ]; then
	echo "eth0: no ethaddr in the U-Boot environment"
elif [ "$mac" != "$(cat /sys/class/net/eth0/address 2> /dev/null)" ]; then
	ip link set eth0 address "$mac"
	echo "eth0: MAC $mac from the U-Boot environment"
fi
