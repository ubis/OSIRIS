# the host name: set by hand, else the model the MCU reported last time
h=
if [ -s /data/etc/hostname ]; then
	h=$(cat /data/etc/hostname)
elif [ -s /data/osiris/state ]; then
	h=$(sed -n 's/^model=//p' /data/osiris/state | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9\n' '-')
fi
hostname "${h:-$(cat /etc/hostname)}"
