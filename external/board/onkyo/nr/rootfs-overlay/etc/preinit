#!/bin/sh
#
# preinit: procd runs this before it starts the services, with /proc, /sys,
# /dev and /tmp mounted. The hooks in /lib/preinit run in order.
#
[ -z "$PREINIT" ] && exec /sbin/init

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
. /usr/lib/osiris/functions.sh

for pi in /lib/preinit/*; do
	. $pi
done
