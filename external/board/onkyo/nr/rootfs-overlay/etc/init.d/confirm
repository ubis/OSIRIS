#!/bin/sh /etc/rc.common
# Getting this far confirms the slot that booted, after an update or a
# fallback: U-Boot boots it from now on, with this system's boot commands.

START=99

. /usr/lib/osiris/functions.sh

ENV_TXT=/usr/share/osiris/u-boot-env.txt
BOOT_VARS="bootcmd bootargs_base bootslot_root bootslot_one bootslot_bootm"

# the name=value lines of U-Boot's environment that have to change
changes() {
	local slot=$1 env=$2 v line

	echo "$env" | grep -qx "bootslot=$slot" || echo "bootslot=$slot"
	for v in $BOOT_VARS; do
		line=$(grep "^$v=" $ENV_TXT)
		echo "$env" | grep -qxF "$line" || echo "$line"
	done
}

start() {
	local slot=$(boot_slot)
	local env=$(fw_printenv 2> /dev/null) set=/tmp/confirm.env

	[ -n "$slot" ] && [ -n "$env" ] || return 0
	changes $slot "$env" > $set
	if [ -s $set ] && fw_setenv -s $set; then
		echo "U-Boot environment: set $(cut -d= -f1 $set | tr '\n' ' ')"
		grep -q "^bootslot=" $set && echo "slot $slot confirmed as the boot slot"
	fi
	rm -f $set
}
