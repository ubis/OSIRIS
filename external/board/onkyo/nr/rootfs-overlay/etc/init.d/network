#!/bin/sh /etc/rc.common

START=40
STOP=60
USE_PROCD=1

start_service() {
	ip link set lo up
	if grep -q " ip=" /proc/cmdline; then
		echo "eth0: configured by the kernel (ip=)"
		return 0
	fi
	procd_open_instance
	procd_set_param command /sbin/udhcpc -f -S -i eth0 \
		-x hostname:$(hostname) -s /usr/share/osiris/udhcpc.script
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
