#!/bin/sh /etc/rc.common

START=41
STOP=59
USE_PROCD=1

start_service() {
	local s servers=$(grep -v '^#' /data/etc/ntp-servers 2> /dev/null)

	procd_open_instance
	procd_set_param command /usr/sbin/ntpd -n -S /usr/share/osiris/ntpd.script
	for s in ${servers:-pool.ntp.org}; do
		procd_append_param command -p $s
	done
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
