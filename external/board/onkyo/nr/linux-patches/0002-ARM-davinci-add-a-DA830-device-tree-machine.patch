From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jokubas Maciulaitis <ubitas52@gmail.com>
Date: Fri, 16 Oct 2026 17:52:35 +0300
Subject: [PATCH 2/6] ARM: davinci: add a DA830 device tree machine

Add ARCH_DAVINCI_DA830 with its CPU ID and a device tree machine for
"ti,da830" in a new da830.c, and build the device tree of the Onkyo
receivers' DSP board.
---
 arch/arm/boot/dts/ti/davinci/Makefile | 1 +
 arch/arm/mach-davinci/Kconfig         | 5 +++++
 arch/arm/mach-davinci/Makefile        | 1 +
 arch/arm/mach-davinci/cputype.h       | 1 +
 4 files changed, 8 insertions(+)

diff --git a/arch/arm/boot/dts/ti/davinci/Makefile b/arch/arm/boot/dts/ti/davinci/Makefile
index c0e388eb3..616e9fd22 100644
--- a/arch/arm/boot/dts/ti/davinci/Makefile
+++ b/arch/arm/boot/dts/ti/davinci/Makefile
@@ -1,5 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0
 dtb-$(CONFIG_ARCH_DAVINCI) += \
+	da830-onkyo-nr.dtb \
 	da850-lcdk.dtb \
 	da850-enbw-cmc.dtb \
 	da850-evm.dtb \
diff --git a/arch/arm/mach-davinci/Kconfig b/arch/arm/mach-davinci/Kconfig
index 6cd6d29a2..66a0ed467 100644
--- a/arch/arm/mach-davinci/Kconfig
+++ b/arch/arm/mach-davinci/Kconfig
@@ -19,6 +19,11 @@ if ARCH_DAVINCI
 
 comment "DaVinci Core Type"
 
+config ARCH_DAVINCI_DA830
+	bool "DA830/OMAP-L137/AM17x based system"
+	select ARCH_DAVINCI_DA8XX
+	select DAVINCI_CP_INTC
+
 config ARCH_DAVINCI_DA850
 	bool "DA850/OMAP-L138/AM18x based system"
 	select ARCH_DAVINCI_DA8XX
diff --git a/arch/arm/mach-davinci/Makefile b/arch/arm/mach-davinci/Makefile
index 7a210db66..31d22a5d8 100644
--- a/arch/arm/mach-davinci/Makefile
+++ b/arch/arm/mach-davinci/Makefile
@@ -10,6 +10,7 @@ obj-y 					:= common.o sram.o devices-da8xx.o
 obj-$(CONFIG_DAVINCI_MUX)		+= mux.o
 
 # Chip specific
+obj-$(CONFIG_ARCH_DAVINCI_DA830)	+= da830.o
 obj-$(CONFIG_ARCH_DAVINCI_DA850)	+= da850.o pdata-quirks.o
 
 obj-y					+= da8xx-dt.o
diff --git a/arch/arm/mach-davinci/cputype.h b/arch/arm/mach-davinci/cputype.h
index a8f5330aa..148a73839 100644
--- a/arch/arm/mach-davinci/cputype.h
+++ b/arch/arm/mach-davinci/cputype.h
@@ -25,6 +25,7 @@ struct davinci_id {
 };
 
 /* Can use lower 16 bits of cpu id  for a variant when required */
+#define	DAVINCI_CPU_ID_DA830		0x08300000
 #define	DAVINCI_CPU_ID_DA850		0x08500000
 
 #endif
