/* U-Boot boots the configuration named in "board", else the default */
/dts-v1/;
/ {
	description = "Linux OSIRIS @VERSION@";
	#address-cells = <1>;
	images {
		kernel {
			description = "Linux";
			data = /incbin/("@IMAGES@/zImage");
			type = "kernel_noload";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0>;
			entry = <0>;
		};
		fdt-onkyo-nr {
			description = "Onkyo DA830/OMAP-L137 DSP board";
			data = /incbin/("@IMAGES@/da830-onkyo-nr.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
		};
		fdt-tx-nr515 {
			description = "Onkyo TX-NR515";
			data = /incbin/("@IMAGES@/da830-onkyo-tx-nr515.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
		};
		fdt-tx-nr717 {
			description = "Onkyo TX-NR717";
			data = /incbin/("@IMAGES@/da830-onkyo-tx-nr717.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
		};
	};
	configurations {
		default = "onkyo-nr";
		onkyo-nr {
			kernel = "kernel";
			fdt = "fdt-onkyo-nr";
		};
		tx-nr515 {
			kernel = "kernel";
			fdt = "fdt-tx-nr515";
		};
		tx-nr717 {
			kernel = "kernel";
			fdt = "fdt-tx-nr717";
		};
	};
};
