--- a/etc/rc.common
+++ b/etc/rc.common
@@ -1,6 +1,10 @@
 #!/bin/sh
 # Copyright (C) 2006-2012 OpenWrt.org
 
+# procd asks a service's script whether it is "running" after each start
+# of it, which matters only to a script with its own service_running()
+[ "$2" = running ] && [ "$PPID" = 1 ] && ! grep -q '^service_running()' "$1" && exit 0
+
 . $IPKG_INSTROOT/lib/functions.sh
 . $IPKG_INSTROOT/lib/functions/service.sh
 
