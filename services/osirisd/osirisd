#!/usr/bin/luajit
-- SPDX-License-Identifier: BSD-2-Clause
--
-- osirisd: the receiver's policy. It listens to the events mcud reports
-- and tells the other services what to do: the model the MCU reports
-- becomes the hostname, the display shows "OSIRIS <build>" as the DSP
-- version, the listening mode picks the speakers the DSP plays on and the
-- tone controls set its bass and treble filters;
-- level calibration plays pink noise on the channel it asks for. The network
-- menu gets the address and link state from the system. Before the MCU
-- switches the board off the data is synced; a factory reset wipes it.
--
-- The master volume is not ours: the MCU sets it in the analog stage after
-- the DAC and reports it (mcu.volume) only for information.

local bit = require "bit"
local ffi = require "ffi"
local ubus = require "ubus"
local uloop = require "uloop"

ffi.cdef [[
void openlog(const char *ident, int option, int facility);
void syslog(int priority, const char *format, ...);
int isatty(int fd);
]]

local LOG_PID, LOG_DAEMON = 0x01, 3 * 8
local LOG_ERR, LOG_INFO = 3, 6
local IDENT = "osirisd"		-- openlog keeps the pointer

local OWN_HOSTNAME = "/data/etc/hostname"
-- what the MCU reported, for the next start: the model (S01hostname reads
-- it at boot) and the listening mode, which the MCU keeps across restarts
-- but does not resend. One key=value per line.
local STATE = "/data/osiris/state"

-- listening modes (D2), with the ISCP name the MCU reports alongside
local LM_ALL_CH_STEREO = 0x0A			-- LMD0C
local LM_FULL_MONO = 0x0B			-- LMD13
local LM_TESTTONE = 0xF1			-- level calibration (C_LM_TESTTONE)

-- calibration channel -> DSP output; front high and wide share the
-- surround back pair
local TESTTONE_OUT = {
	fl = "fl", fr = "fr", c = "c", sw = "sw", sl = "sl", sr = "sr",
	sbl = "sbl", sbr = "sbr", fhl = "sbl", fhr = "sbr", fwl = "sbl", fwr = "sbr",
}
local TESTTONE_LEVEL = -70		-- dBFS RMS, at the MCU's reference volume

-- speakers per listening mode; anything else (stereo, direct and the
-- surround modes the DSP cannot do yet) plays on the front pair
local MODE_OUTPUTS = {
	[LM_ALL_CH_STEREO] = "all",
	[LM_FULL_MONO] = "mono",
}

local IFACE = "eth0"

local mode_now
local testtone_ch = "fl"

local conn

-- to the terminal when run from one, to syslog when run as a daemon
local TERMINAL = ffi.C.isatty(2) == 1

local function say(prio, fmt, ...)
	local s = string.format(fmt, ...)
	if TERMINAL then
		io.stderr:write(s, "\n")
	else
		ffi.C.syslog(prio, "%s", s)
	end
end

local function log(fmt, ...)
	say(LOG_INFO, fmt, ...)
end

local function err(fmt, ...)
	say(LOG_ERR, fmt, ...)
end

local function read_file(path)
	local f = io.open(path, "r")
	if not f then
		return nil
	end
	local s = f:read("*a")
	f:close()
	return s
end

local function write_file(path, text)
	local tmp = path .. ".tmp"
	local f = io.open(tmp, "w")
	if not f then
		return false
	end
	f:write(text)
	f:close()
	return os.rename(tmp, path)
end

local function load_state()
	local t = {}

	for k, v in (read_file(STATE) or ""):gmatch("([%w_]+)=([^\n]*)") do
		t[k] = v
	end

	return t
end

-- merge into the state file, rewritten (atomically) only when it changes
local function save_state(changes)
	local t = load_state()
	local keys, lines = {}, {}

	for k, v in pairs(changes) do
		t[k] = tostring(v)
	end

	for k in pairs(t) do
		keys[#keys + 1] = k
	end

	table.sort(keys)
	for _, k in ipairs(keys) do
		lines[#lines + 1] = k .. "=" .. t[k] .. "\n"
	end

	local text = table.concat(lines)
	if text ~= read_file(STATE) then
		write_file(STATE, text)
	end
end

local function call(object, method, args)
	local res = conn:call(object, method, args or {})
	if not res and method ~= "set" and method ~= "identity" and method ~= "network" and
	   method ~= "power" then
		err("%s %s: no answer", object, method)
	end
	return res
end

-- the version the receiver shows for the DSP: "OSIRIS <build>"
-- the receiver shows 14 characters: "OSIRIS v0.1.0" for a release, the
-- commit for a build in between ("v0.1.0~g1de0787" -> "OSIRIS 1de0787")
local function set_identity()
	local build = (read_file("/etc/osiris-version") or ""):gsub("%s+$", "")
	local shown = "OSIRIS " .. build

	if #shown > 14 then
		shown = "OSIRIS " .. (build:match("~g(%x+)") or build)
	end

	call("mcu", "identity", { dsp_version = shown:sub(1, 14) })
end

-- name the system after the receiver model the MCU reports
local function set_model(m)
	if not m or not m.model or m.model == "" then
		return
	end

	save_state({ make = m.make, model = m.model, code = m.code })

	if read_file(OWN_HOSTNAME) then
		log("%s %s, keeping the hostname from %s", m.make or "", m.model, OWN_HOSTNAME)
		return
	end

	local host = m.model:upper():gsub("[^A-Z0-9]", "-")
	os.execute("hostname " .. host)
	log("%s %s (%s), hostname %s", m.make or "", m.model, m.code or "", host)
end

-- noise only during level calibration, on the channel the MCU picked
local function set_testtone()
	local out = mode_now == LM_TESTTONE and TESTTONE_OUT[testtone_ch] or "off"

	call("dsp", "set", { testtone = out, testtone_level = TESTTONE_LEVEL })
end

local function set_mode(mode)
	if not mode then
		return
	end

	-- not the test tone: a restart must not come back into calibration
	if mode ~= LM_TESTTONE then
		save_state({ listening_mode = mode })
	end

	mode_now = mode
	call("dsp", "set", { outputs = MODE_OUTPUTS[mode] or "front" })
	set_testtone()
end

-- front bass and treble in dB, from the receiver's tone controls
local function set_tone(bass, treble)
	if not bass or not treble then
		return
	end

	save_state({ bass = bass, treble = treble })
	call("dsp", "set", { bass = bass, treble = treble })
end

-- what the network menu shows; mcud answers the MCU with it
local function set_network()
	local p = io.popen("ifconfig " .. IFACE .. " 2> /dev/null")
	local ifc = p:read("*a")
	local n = { dhcp = true, dns = {} }

	p:close()
	n.ip = ifc:match("inet addr:([%d%.]+)")
	n.netmask = ifc:match("Mask:([%d%.]+)")
	n.link = (read_file("/sys/class/net/" .. IFACE .. "/carrier") or ""):match("^1") ~= nil
	n.mac = (read_file("/sys/class/net/" .. IFACE .. "/address") or ""):gsub("%s", "")
	n.name = (read_file("/proc/sys/kernel/hostname") or ""):gsub("%s", "")

	-- default route, the gateway in host (little endian) order
	local gw = (read_file("/proc/net/route") or ""):match(IFACE .. "%s+00000000%s+(%x+)")
	if gw then
		local v = tonumber(gw, 16)
		n.gateway = string.format("%d.%d.%d.%d", bit.band(v, 0xff),
					  bit.band(bit.rshift(v, 8), 0xff),
					  bit.band(bit.rshift(v, 16), 0xff),
					  bit.rshift(v, 24))
	end

	for ns in (read_file("/etc/resolv.conf") or ""):gmatch("nameserver%s+([%d%.]+)") do
		n.dns[#n.dns + 1] = ns
	end

	call("mcu", "network", n)
end

-- the MCU cuts the power once we answer; S01data sets up a wiped /data again
local function power(state)
	if state ~= "off" and state ~= "reset" then
		return
	end

	if state == "reset" then
		log("factory reset: wiping /data")
		os.execute("rm -rf /data/* /data/.[!.]*")
	end

	os.execute("sync")
	call("mcu", "power", { state = state })
	if state == "reset" then
		os.execute("(sleep 2; reboot) &")
	end
end

local handlers = {
	["mcu.ready"] = function(msg)
		set_model(msg)
	end,
	["mcu.listening_mode"] = function(msg)
		set_mode(msg.mode)
	end,
	["mcu.testtone"] = function(msg)
		testtone_ch = msg.channel or testtone_ch
		set_testtone()
	end,
	["mcu.tone"] = function(msg)
		set_tone(msg.bass, msg.treble)
	end,
	["mcu.network"] = function()
		set_network()
	end,
	["mcu.power"] = function(msg)
		power(msg.state)
	end,
}

ffi.C.openlog(IDENT, LOG_PID, LOG_DAEMON)
uloop.init()
conn = ubus.connect()
if not conn then
	err("cannot connect to ubusd")
	os.exit(1)
end

conn:listen(handlers)
set_identity()

-- mcud may have finished its handshake before we started
local st = call("mcu", "status")
if st and st.stage == "ready" then
	set_model(st)
end

local saved = load_state()
set_mode(st and st.listening_mode or tonumber(saved.listening_mode or ""))
if st and st.bass then
	set_tone(st.bass, st.treble)
else
	set_tone(tonumber(saved.bass or ""), tonumber(saved.treble or ""))
end

uloop.run()
