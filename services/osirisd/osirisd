#!/usr/bin/luajit
-- SPDX-License-Identifier: BSD-2-Clause
--
-- osirisd: the receiver's policy. It listens to the events mcud reports
-- and tells the other services what to do: the model the MCU reports
-- becomes the hostname, the display shows "OSIRIS <build>" as the DSP
-- version, the listening mode picks the speakers and the surround decoder
-- preset the DSP plays with, the tone controls set its bass and treble
-- filters and the speaker distances the outputs' delays; level calibration
-- plays pink noise on the channel it asks for. The network
-- menu gets the address and link state from the system. Before the MCU
-- switches the board off the data is synced; a factory reset wipes it.
-- An update bundle of another version on a USB stick is offered when the
-- MCU asks for updates; it then shows its update notice, and the receiver's
-- own update screens run osiris-upgrade with its progress.
--
-- The MCU applies the master volume in the analog stage after the DAC.
-- OSIRIS reads it (mcu.volume) for Dynamic EQ and sets it only from the
-- AirPlay slider.

-- the modules beside the script first, so that a copy in /tmp runs its own
local dir = arg[0]:match("^(.*)/[^/]*$") or "."
package.path = dir .. "/?.lua;/usr/share/osirisd/?.lua;" .. package.path

local ubus = require "ubus"
local uloop = require "uloop"
local events = require "events"
-- each module registers the events it handles as it loads
local system = require "system"
local stream = require "stream"
local audio = require "audio"
local airplay = require "airplay"
local update = require "update"
local util = require "util"

local call, err, load_state = util.call, util.err, util.load_state

-- in this order: the Dolby state goes before the rest is sent again
events.on("dsp.ready", function()
	audio.dsp_lost()
	stream.dsp_lost()
	audio.dsp_setup()
end)

util.open_log()
uloop.init()
airplay.start()
local conn = ubus.connect()
if not conn then
	err("cannot connect to ubusd")
	os.exit(1)
end
util.set_conn(conn)

events.listen(conn)
system.set_identity()
update.scan_media()

-- mcud may have finished its handshake before we started
local st = call("mcu", "status")
-- the MCU may have asked for updates before we listened
update.answer_check(st)

if st and st.stage == "ready" then
	system.set_model(st)
	update.set_usb()
end

local saved = load_state()
airplay.set_display(saved.display)
stream.start_decoded(call("dsp", "status"))
if st and (st.listening_mode or st.listening_mode_name) then
	audio.set_mode(st.listening_mode, st.listening_mode_name)
else
	audio.set_mode(tonumber(saved.listening_mode or ""), saved.listening_mode_name)
end
if st and st.bass then
	audio.set_tone(st.bass, st.treble)
else
	audio.set_tone(tonumber(saved.bass or ""), tonumber(saved.treble or ""))
end

audio.set_speakers(st)
audio.set_distances(st and st.distances or audio.saved_distances(saved))
audio.set_lfe("multichannel_pcm", tonumber(saved.lfe_multichannel_pcm or "") or 0)
if st and st.late_night then
	audio.set_late_night(st.late_night)
end
if st and st.av_sync then
	audio.set_av_sync(st.av_sync)
end
audio.start_levels(st, saved)
audio.set_eq(audio.saved_eq(saved))
audio.set_eq(st and st.equalizer)
if st and st.interface then
	stream.set_input(st.interface, st.fs, st.channels)
end

uloop.run()
