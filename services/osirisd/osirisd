#!/usr/bin/luajit
-- SPDX-License-Identifier: BSD-2-Clause
--
-- osirisd: the receiver's policy. It listens to the events mcud reports
-- and tells the other services what to do: the model the MCU reports
-- becomes the hostname, the display shows "OSIRIS <build>" as the DSP
-- version, the listening mode picks the speakers and the surround decoder
-- preset the DSP plays with, the tone controls set its bass and treble
-- filters and the speaker distances the outputs' delays; level calibration
-- plays pink noise on the channel it asks for. The network
-- menu gets the address and link state from the system. Before the MCU
-- switches the board off the data is synced; a factory reset wipes it.
-- An update bundle of another version on a USB stick is offered when the
-- MCU asks for updates; it then shows its update notice, and the receiver's
-- own update screens run osiris-upgrade with its progress.
--
-- The MCU applies the master volume in the analog stage after the DAC.
-- OSIRIS reads it (mcu.volume) for Dynamic EQ and sets it only from the
-- AirPlay slider.

local bit = require "bit"
local ffi = require "ffi"
local ubus = require "ubus"
local uloop = require "uloop"

ffi.cdef [[
void openlog(const char *ident, int option, int facility);
void syslog(int priority, const char *format, ...);
int isatty(int fd);
int open(const char *path, int flags, ...);
long read(int fd, void *buf, unsigned long n);
int mkfifo(const char *path, unsigned int mode);
int kill(int pid, int sig);
]]

local LOG_PID, LOG_DAEMON = 0x01, 3 * 8
local LOG_ERR, LOG_INFO = 3, 6
local IDENT = "osirisd"		-- openlog keeps the pointer

local OWN_HOSTNAME = "/data/etc/hostname"
-- what the MCU reported, for the next start: the model (S01hostname reads
-- it at boot) and the listening mode, which the MCU keeps across restarts
-- but does not resend. One key=value per line.
local STATE = "/data/osiris/state"

-- listening modes (D2), with the ISCP name the MCU reports alongside
local LM_STEREO = 0x04				-- LMD00
local LM_ALL_CH_STEREO = 0x0A			-- LMD0C
local LM_FULL_MONO = 0x0B			-- LMD13
local LM_TESTTONE = 0xF1			-- level calibration (C_LM_TESTTONE)

-- calibration channel -> DSP output; front high and wide share the
-- surround back pair
local TESTTONE_OUT = {
	fl = "fl", fr = "fr", c = "c", sw = "sw", sl = "sl", sr = "sr",
	sbl = "sbl", sbr = "sbr", fhl = "sbl", fhr = "sbr", fwl = "sbl", fwr = "sbr",
}
local TESTTONE_LEVEL = -70		-- dBFS RMS, at the MCU's reference volume

-- speakers per listening mode, by the MCU's byte until it names the mode;
-- anything else (stereo, direct, the modes the DSP cannot do yet) plays on
-- the front pair
local MODE_OUTPUTS = {
	[LM_ALL_CH_STEREO] = "all",
	[LM_FULL_MONO] = "mono",
	all_ch_stereo = "all",
	full_mono = "mono",
}

-- the surround decoder's preset for the modes that make surround from
-- stereo, the sound field modes too
local MODE_SURROUND = {
	surround = "movie", film = "movie", thx = "movie", thx_cinema = "movie",
	tv_logic = "movie", neural_surround = "movie",
	plii_movie = "movie", plii_thx_cinema = "movie", plii_movie_dsx = "movie",
	neo6_cinema = "movie", neo6_thx_cinema = "movie", neo6_cinema_dsx = "movie",
	pliiz_height = "movie", pliiz_height_thx_cinema = "movie",
	musical = "music", orchestra = "music", unplugged = "music",
	studio_mix = "music", thx_music = "music",
	plii_music = "music", plii_thx_music = "music", plii_music_dsx = "music",
	neo6_music = "music", neo6_thx_music = "music", neo6_music_dsx = "music",
	pliiz_height_thx_music = "music",
	action = "game", thx_games = "game",
	plii_game = "game", plii_thx_games = "game", plii_game_dsx = "game",
	neo6_thx_games = "game", pliiz_height_thx_games = "game",
}

-- the room the sound field modes add on top of it
local MODE_REVERB = {
	orchestra = "hall", unplugged = "club", studio_mix = "studio",
	film = "theater", musical = "theater", action = "theater", tv_logic = "tv",
}

local IFACE = "eth0"

-- the DSP's outputs; the surround back amplifiers drive surround back,
-- front high or front wide speakers, as the receiver's layout says
local OUTPUTS = { "fl", "fr", "c", "sw", "sl", "sr", "sbl", "sbr" }
local BACK = {
	sb = { speaker = "surround_back", l = "sbl", r = "sbr" },
	fh = { speaker = "front_high", l = "fhl", r = "fhr" },
	fw = { speaker = "front_wide", l = "fwl", r = "fwr" },
}
-- C1 sample rate codes
local FS_HZ = { [8] = 44100, [9] = 48000, [12] = 96000 }
local EQ_SPEAKERS = {
	"front", "center", "surround", "surround_back", "front_high", "front_wide", "subwoofer",
}
local OUTPUT_SPEAKER = {
	fl = "front", fr = "front", c = "center", sl = "surround", sr = "surround",
}

local UPGRADE_LOG = "/tmp/osiris-upgrade.log"
local PROGRESS_MS = 4000	-- the MCU gives up after ~20 s without progress
-- osiris-upgrade's output -> percent
local INSTALL_STEPS = {
	{ "running ", 15 }, { "writing uImage", 20 }, { "writing rootfs", 30 },
	{ "writing u-boot", 90 }, { "will be tried", 100 },
}

local mode_now, mode_name
local back = BACK.sb		-- what the surround back outputs play
local distances_now		-- the MCU's distances by speaker
local testtone_ch = "fl"
local eq_now = {}		-- the receiver's equalizer: eq_on and bands by speaker
local fs_now			-- Hz, the source's sample rate
local channels_now, back_fill_now	-- the source's channel allocation; SB filled
local set_back_fill
local input_now			-- "analog", "digital", "multichannel", "network"; nil: not known yet
local lfe_pcm = 0		-- dB, the LFE level for multichannel PCM; -100 off
local media = {}		-- mounted USB storage, by directory
local bundle			-- { path, version } of an update on it
local job			-- the running update step: its steps, percent, process
local progress_timer		-- made once: cancelling one frees its callback twice

local conn

-- to the terminal when run from one, to syslog when run as a daemon
local TERMINAL = ffi.C.isatty(2) == 1

local function say(prio, fmt, ...)
	local s = string.format(fmt, ...)
	if TERMINAL then
		io.stderr:write(s, "\n")
	else
		ffi.C.syslog(prio, "%s", s)
	end
end

local function log(fmt, ...)
	say(LOG_INFO, fmt, ...)
end

local function err(fmt, ...)
	say(LOG_ERR, fmt, ...)
end

local function read_file(path)
	local f = io.open(path, "r")
	if not f then
		return nil
	end
	local s = f:read("*a")
	f:close()
	return s
end

local function write_file(path, text)
	local tmp = path .. ".tmp"
	local f = io.open(tmp, "w")
	if not f then
		return false
	end
	f:write(text)
	f:close()
	return os.rename(tmp, path)
end

local function load_state()
	local t = {}

	for k, v in (read_file(STATE) or ""):gmatch("([%w_]+)=([^\n]*)") do
		t[k] = v
	end

	return t
end

-- merge into the state file, rewritten (atomically) only when it changes
local function save_state(changes)
	local t = load_state()
	local keys, lines = {}, {}

	for k, v in pairs(changes) do
		t[k] = tostring(v)
	end

	for k in pairs(t) do
		keys[#keys + 1] = k
	end

	table.sort(keys)
	for _, k in ipairs(keys) do
		lines[#lines + 1] = k .. "=" .. t[k] .. "\n"
	end

	local text = table.concat(lines)
	if text ~= read_file(STATE) then
		write_file(STATE, text)
	end
end

local function call(object, method, args)
	local res = conn:call(object, method, args or {})
	if not res and method ~= "set" and method ~= "identity" and method ~= "network" and
	   method ~= "power" and method ~= "update" and method ~= "usb" and
	   method ~= "display" and method ~= "meter" and method ~= "input" and method ~= "volume" and method ~= "stream" then
		err("%s %s: no answer", object, method)
	end
	return res
end

-- the version the receiver shows for the DSP: "OSIRIS <build>"
-- the receiver shows 14 characters: "OSIRIS v0.1.0" for a release, the
-- commit for a build in between ("v0.1.0~g1de0787" -> "OSIRIS 1de0787")
local function set_identity()
	local build = (read_file("/etc/osiris-version") or ""):gsub("%s+$", "")
	local shown = "OSIRIS " .. build

	if #shown > 14 then
		shown = "OSIRIS " .. (build:match("~g(%x+)") or build)
	end

	call("mcu", "identity", { dsp_version = shown:sub(1, 14) })
end

-- name the system after the receiver model the MCU reports
local function set_model(m)
	if not m or not m.model or m.model == "" then
		return
	end

	save_state({ make = m.make, model = m.model, code = m.code })

	if read_file(OWN_HOSTNAME) then
		log("%s %s, keeping the hostname from %s", m.make or "", m.model, OWN_HOSTNAME)
		return
	end

	local host = m.model:upper():gsub("[^A-Z0-9]", "-")
	os.execute("hostname " .. host)
	log("%s %s (%s), hostname %s", m.make or "", m.model, m.code or "", host)
end

-- A/V sync in ms: the MCU sends the menu's value less the 22 ms the stock
-- DSP delayed anyway, and 0 for anything up to 20 ms
local AV_STOCK_MS = 22
local LOUDNESS_DB_PER = 4	-- dB below reference per dB of bass boost
local LOUDNESS_MAX = 10
local av_now = 0
local volume_now, adsy_now, loudness_now = 0, {}, nil

-- Late Night, the MCU's setting for Dolby Digital
local LATE_NIGHT = { off = 0, low = 1, high = 2 }
local late_now = 0

local function set_late_night(name)
	late_now = LATE_NIGHT[name] or 0
	call("dsp", "set", { late_night = late_now })
end

local function set_av_sync(ms)
	av_now = ms > 0 and ms + AV_STOCK_MS or 0
	call("dsp", "set", { av_sync = av_now })
end

-- Dynamic EQ: more bass the further the volume (0 dB is the reference) is
-- below the reference, less the higher the reference level offset
local function set_loudness()
	local db = -1

	if adsy_now.dynamic_eq then
		local below = -volume_now / 100 - (adsy_now.dynamic_eq_offset or 0)

		db = math.floor(math.max(0, math.min(LOUDNESS_MAX, below / LOUDNESS_DB_PER)) + 0.5)
	end

	if db ~= loudness_now then
		loudness_now = db
		call("dsp", "set", { loudness = db })
	end
end

-- Dynamic Volume, 0 off to 3 heavy, as the MCU sets it
local function set_dynamic_volume()
	call("dsp", "set", { dynamic_volume = adsy_now.dynamic_volume or 0 })
end

-- how much of the LFE channel multichannel PCM plays; the receiver has one
-- setting per format, the DSP plays PCM only
local function set_lfe(format, db)
	if format ~= "multichannel_pcm" or not db then
		return
	end

	lfe_pcm = db
	save_state({ lfe_multichannel_pcm = db })
	call("dsp", "set", { lfe_level = db })
end

-- noise only during level calibration, on the channel the MCU picked
local function set_testtone()
	local out = mode_now == LM_TESTTONE and TESTTONE_OUT[testtone_ch] or "off"

	call("dsp", "set", { testtone = out, testtone_level = TESTTONE_LEVEL })
end

-- by the name of the mode's ISCP code, the MCU's byte only where there is
-- no name yet; either can be missing
local function set_mode(mode, name)
	if not mode and not name then
		return
	end

	-- not the test tone: a restart must not come back into calibration
	if mode ~= LM_TESTTONE then
		save_state({ listening_mode = mode or "", listening_mode_name = name or "" })
	end

	mode_now, mode_name = mode, name
	local surround = mode ~= LM_TESTTONE and MODE_SURROUND[name] or "off"
	local outputs = MODE_OUTPUTS[name] or MODE_OUTPUTS[mode] or "front"

	-- multichannel already has its channels: Stereo folds them down
	if input_now == "multichannel" then
		surround = "off"
		if outputs == "front" and name ~= "stereo" and (name or mode ~= LM_STEREO) then
			outputs = "multichannel"
		end
	end

	call("dsp", "set", {
		outputs = outputs,
		surround = surround,
		reverb = surround ~= "off" and MODE_REVERB[name] or "off",
	})
	set_testtone()
	set_back_fill()
end

-- multichannel without surround back or rear centre (CEA-861 allocation
-- below 0x10 without bit 2) on surround back speakers: they repeat the
-- surrounds, except in the modes that play the source as it is
local UNPROCESSED = { direct = true, pure_audio = true }

function set_back_fill()
	local ca = channels_now or 0
	local fill = input_now == "multichannel" and ca < 0x10 and bit.band(ca, 0x04) == 0 and
		     back == BACK.sb and not UNPROCESSED[mode_name] and true or false

	if fill ~= back_fill_now then
		back_fill_now = fill
		call("dsp", "set", { back_fill = fill })
	end
end

-- multichannel PCM from HDMI as AudioApp tells the MCU (type 0E, format 70):
-- from the CEA-861 allocation below 0x14 (bit 0 LFE, 1 centre, 2-3 the rear:
-- one, a pair or both; 0x10 and up the surround and back pairs) the source's
-- channel mask (FL FR 0005, C 0002, SL SR 0088, SB 0020, SBL SBR 0050) and
-- " 5.1"
local STREAM_PCM = { type = 2, input_mask = 0x0005, lfe = false, channels = " 2.0", format = 0x20 }
local REAR_MASK = { [0] = 0, 0x0020, 0x0088, 0x00A8 }
local REAR_COUNT = { [0] = 0, 1, 2, 3 }
local stream_now		-- the stream status last sent for PCM
local pcm_streams = {}		-- one per allocation, so equal ones compare equal

local function pcm_stream(ca)
	if not ca or ca >= 0x14 then
		return STREAM_PCM
	end
	if pcm_streams[ca] then
		return pcm_streams[ca]
	end

	local lfe, fc = bit.band(ca, 1) ~= 0, bit.band(ca, 2) ~= 0
	local back = bit.band(ca, 0x10) ~= 0
	local rear = back and 2 or bit.band(bit.rshift(ca, 2), 3)
	local mask = 0x0005 + (fc and 0x0002 or 0) + REAR_MASK[rear] + (back and 0x0050 or 0)
	local n = 2 + (fc and 1 or 0) + REAR_COUNT[rear] + (back and 2 or 0)

	pcm_streams[ca] = { type = 0x0E, input_mask = mask, lfe = lfe,
			    channels = string.format(" %d.%d", n, lfe and 1 or 0), format = 0x70 }
	return pcm_streams[ca]
end

-- AC-3 the DSP decodes (dsp.bitstream): with a centre or surrounds it plays
-- as multichannel from a digital input; ac3_ca is its layout as a CEA-861
-- allocation, nil otherwise. ac3_now: the 0x42 the MCU got for it. c1_*:
-- the MCU's last input report, to go back to.
local ac3_ca, ac3_now, c1_interface, c1_channels

-- the source by the MCU's C1 interface: 1 analog, 2 multichannel PCM from
-- HDMI, 5 the NET input (audio from Linux), else digital
local function set_input(interface, fs, channels)
	c1_interface, c1_channels = interface, channels or c1_channels
	local decoded = ac3_ca and interface ~= 1 and interface ~= 5
	local input = decoded and "multichannel" or interface == 1 and "analog" or
		      interface == 2 and "multichannel" or interface == 5 and "network" or "digital"
	local was = input_now

	-- the DSP works out its filters and delays for the rate the MCU reports
	-- a code not known yet above 48 kHz: at least process every other frame
	local hz = FS_HZ[fs] or fs and fs > 9 and 96000

	if hz and hz ~= fs_now then
		fs_now = hz
		call("dsp", "set", { fs = hz })
	end

	input_now = input
	channels_now = decoded and ac3_ca or c1_channels

	-- what the MCU shows for PCM: stereo, or multichannel from HDMI
	if not ac3_now then
		local st = interface == 2 and pcm_stream(channels_now) or STREAM_PCM
		if st ~= stream_now then
			stream_now = st
			call("mcu", "stream", st)
		end
	end
	set_back_fill()
	if input == was then
		return
	end

	call("dsp", "set", { input = input, meter = input == "network" })
	if (input == "multichannel") ~= (was == "multichannel") then
		set_mode(mode_now, mode_name)
	end
end

-- front bass and treble in dB, from the receiver's tone controls
local function set_tone(bass, treble)
	if not bass or not treble then
		return
	end

	save_state({ bass = bass, treble = treble })
	call("dsp", "set", { bass = bass, treble = treble })
end

-- speaker distances in cm; the DSP holds the nearer speakers back
local function set_distances(d)
	if not d then
		return
	end

	local out, save = {}, {}

	distances_now = d
	for _, o in ipairs(OUTPUTS) do
		local cm

		if o == "sbl" or o == "sbr" then
			cm = d[o == "sbl" and back.l or back.r] or d[o]
		else
			cm = d[o]
		end

		out[o] = tonumber(cm) or 0
		save["distance_" .. o] = out[o]
	end

	save_state(save)
	call("dsp", "set", { distances = out })
end

-- the receiver's equalizer on the outputs, flat while it is off; the
-- surround back outputs take the bands of what the layout has them drive.
-- mcud reports only what the MCU has sent since it started: the rest stays.
local function set_eq(e)
	local bands, out = {}, {}

	for k, v in pairs(e or {}) do
		eq_now[k] = v
	end

	e = eq_now
	local save = { eq_on = e.eq_on and 1 or 0 }
	for _, sp in ipairs(EQ_SPEAKERS) do
		local b = type(e[sp]) == "table" and e[sp] or {}

		bands[sp] = e.eq_on and b or {}
		save["eq_" .. sp] = table.concat(b, ",")
	end

	for _, o in ipairs(OUTPUTS) do
		local sp = o == "sw" and "subwoofer" or (o == "sbl" or o == "sbr") and back.speaker or
			   OUTPUT_SPEAKER[o]

		out[o] = bands[sp] or {}
	end

	save_state(save)
	call("dsp", "set", { eq = out })
end

-- the equalizer as saved, for a start before the MCU reports it
local function saved_eq(saved)
	local e = { eq_on = saved.eq_on == "1" }

	for _, sp in ipairs(EQ_SPEAKERS) do
		local b = {}

		for v in (saved["eq_" .. sp] or ""):gmatch("-?%d+") do
			b[#b + 1] = tonumber(v)
		end

		e[sp] = b
	end

	return e
end

-- the speakers there are, small ones' bass to the subwoofer
local function set_speakers(m)
	if not m or not m.speakers then
		return
	end

	local sp, crossover, absent = m.speakers, {}, {}
	local kind = (m.layout or "sb"):match("^(%a%a)")

	back = BACK[kind] or BACK.sb
	for _, o in ipairs(OUTPUTS) do
		local name = o == "sbl" and back.speaker or o == "sbr" and back.speaker or
			     OUTPUT_SPEAKER[o]

		if o == "sw" then
			if (m.subwoofers or 0) == 0 then
				absent[#absent + 1] = o
			end
		elseif kind == "no" and (o == "sbl" or o == "sbr") or sp[name] == nil then
			absent[#absent + 1] = o
			crossover[o] = 0
		else
			crossover[o] = sp[name]
		end
	end

	call("dsp", "set", {
		crossover = crossover,
		subwoofer = (m.subwoofers or 0) > 0,
		sub_lowpass = m.lfe_lowpass or 0,
		double_bass = m.double_bass and true or false,
		absent = absent,
	})
	set_distances(distances_now)
	set_back_fill()
	-- not before the saved equalizer is loaded, it would be saved flat
	if next(eq_now) then
		set_eq()
	end
end

local function saved_distances(saved)
	local d

	for _, o in ipairs(OUTPUTS) do
		local cm = tonumber(saved["distance_" .. o] or "")

		if cm then
			d = d or {}
			d[o] = cm
		end
	end

	return d
end

-- what the network menu shows; mcud answers the MCU with it
local function set_network()
	local p = io.popen("ifconfig " .. IFACE .. " 2> /dev/null")
	local ifc = p:read("*a")
	local n = { dhcp = true, dns = {} }

	p:close()
	n.ip = ifc:match("inet addr:([%d%.]+)")
	n.netmask = ifc:match("Mask:([%d%.]+)")
	n.link = (read_file("/sys/class/net/" .. IFACE .. "/carrier") or ""):match("^1") ~= nil
	n.mac = (read_file("/sys/class/net/" .. IFACE .. "/address") or ""):gsub("%s", "")
	n.name = (read_file("/proc/sys/kernel/hostname") or ""):gsub("%s", "")

	-- default route, the gateway in host (little endian) order
	local gw = (read_file("/proc/net/route") or ""):match(IFACE .. "%s+00000000%s+(%x+)")
	if gw then
		local v = tonumber(gw, 16)
		n.gateway = string.format("%d.%d.%d.%d", bit.band(v, 0xff),
					  bit.band(bit.rshift(v, 8), 0xff),
					  bit.band(bit.rshift(v, 16), 0xff),
					  bit.rshift(v, 24))
	end

	for ns in (read_file("/etc/resolv.conf") or ""):gmatch("nameserver%s+([%d%.]+)") do
		n.dns[#n.dns + 1] = ns
	end

	call("mcu", "network", n)
end

local function quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function running_version()
	return (read_file("/etc/osiris-version") or ""):gsub("%s+$", "")
end

local function set_usb()
	call("mcu", "usb", { present = next(media) ~= nil })
end

local function set_media(dir, present)
	media[dir] = present or nil
	if not present and bundle and bundle.path:sub(1, #dir + 1) == dir .. "/" then
		log("update %s gone", bundle.path)
		bundle = nil
	end

	set_usb()
end

local function set_bundle(path, version)
	if not path or not version or version == running_version() then
		return
	end

	log("update %s (%s) on USB", path, version)
	bundle = { path = path, version = version }
	-- the MCU waits ~2.5 min for an answer before it asks again
	local st = call("mcu", "status")

	if st and st.update_check then
		call("mcu", "update", { available = true })
	end
end

-- sticks mounted before we listened
local function scan_media()
	for line in (read_file("/proc/mounts") or ""):gmatch("[^\n]+") do
		local dir = line:match("^%S+ (/media/%S+) ")
		if dir then
			media[dir] = true
		end
	end

	for dir in pairs(media) do
		local p = io.popen("ls " .. quote(dir) .. "/osiris-*.tar 2> /dev/null")
		for f in p:lines() do
			local v = io.popen("tar -xOf " .. quote(f) .. " VERSION 2> /dev/null")
			set_bundle(f, (v:read("*a") or ""):gsub("%s+$", ""))
			v:close()
		end
		p:close()
	end
end

-- the percent the steps reach in UPGRADE_LOG, repeated so that the MCU does
-- not give up
local function progress_tick()
	if not job then
		return
	end

	local out = read_file(UPGRADE_LOG) or ""

	for _, s in ipairs(job.steps) do
		if s[2] > job.percent and out:find(s[1], 1, true) then
			job.percent = s[2]
		end
	end

	call("mcu", "update", { progress = job.percent })
	progress_timer:set(PROGRESS_MS)
end

-- run an update step, its output to UPGRADE_LOG
local function run_step(cmd, steps, done)
	os.remove(UPGRADE_LOG)
	call("mcu", "update", { progress = 0 })
	job = { steps = steps, percent = 0 }
	progress_timer = progress_timer or uloop.timer(progress_tick)
	progress_timer:set(PROGRESS_MS)

	-- kept in job: uloop lists the process, and the binding does not keep it
	job.process = uloop.process("/bin/sh", { "-c", cmd .. " > " .. UPGRADE_LOG .. " 2>&1" },
				    { "PATH=/usr/sbin:/usr/bin:/sbin:/bin" }, function(ret)
		job = nil
		if ret ~= 0 then
			err("update failed: %s", (read_file(UPGRADE_LOG) or ""):gsub("%s+$", ""))
		end

		done(ret == 0)
	end)
end

-- the stick is read once in full before the MCU is told to go on
local function download()
	local b = bundle

	if not b or job then
		call("mcu", "update", { result = "error" })
		return
	end

	log("reading %s", b.path)
	run_step("tar -tf " .. quote(b.path), {}, function(ok)
		if not ok then
			call("mcu", "update", { result = "error" })
			return
		end

		call("mcu", "update", { progress = 100 })
		local f = io.open(b.path, "r")
		call("mcu", "update", { downloaded = f and f:seek("end") or 0 })
		if f then
			f:close()
		end
	end)
end

-- the new slot boots when the user switches the receiver off and on again,
-- as the MCU asks after "Completed!"
local function install()
	local b = bundle

	if not b or job then
		call("mcu", "update", { result = "error" })
		return
	end

	log("installing %s", b.version)
	run_step("osiris-upgrade -n " .. quote(b.path), INSTALL_STEPS, function(ok)
		-- the MCU takes the result, an error too, only after 100 %
		call("mcu", "update", { progress = 100 })
		call("mcu", "update", { result = ok and "ok" or "error" })
		if ok then
			bundle = nil
		end
	end)
end

local function update(stage)
	if stage == "check" then
		-- unanswered, the MCU asks again later: the notice can still come
		if bundle then
			call("mcu", "update", { available = true })
		end
	elseif stage == "download" then
		download()
	elseif stage == "install" then
		install()
	end
end

-- the MCU cuts the power once we answer; S01data sets up a wiped /data again
local function power(state)
	if state ~= "off" and state ~= "reset" then
		return
	end

	if state == "reset" then
		log("factory reset: wiping /data")
		os.execute("rm -rf /data/* /data/.[!.]*")
	end

	os.execute("sync")
	call("mcu", "power", { state = state })
	if state == "reset" then
		os.execute("(sleep 2; reboot) &")
	end
end

-- AirPlay: shairport-sync's metadata pipe gives the track and the play
-- state; they go to the front panel, and a pause or skip makes pcmd drop
-- what it has queued. The binding has no fd watch, so a timer polls it.
local META_PIPE = "/var/run/airplay-meta"
local META_MS = 100
local O_RDWR, O_NONBLOCK, SIGUSR1 = 2, 0x800, 10
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local meta_fd, meta_buf, meta_timer = -1, ""
local track = { state = "stop" }
local meta_chunk = ffi.new("char[4096]")

local function base64(s)
	local out, bits, n = {}, 0, 0
	for c in s:gmatch("[%w+/]") do
		bits = bit.bor(bit.lshift(bits, 6), B64:find(c, 1, true) - 1)
		n = n + 6
		if n >= 8 then
			n = n - 8
			out[#out + 1] = string.char(bit.band(bit.rshift(bits, n), 0xff))
		end
	end
	return table.concat(out)
end

local function set_display(mode)
	if mode then
		call("mcu", "display", { mode = mode })
	end
end

local function show_track()
	call("mcu", "display", { title = track.title or "", artist = track.artist or "",
				 album = track.album or "", state = track.state })
end

local function pcmd_flush()
	local pid = tonumber(read_file("/var/run/pcmd.pid") or "")
	if pid then
		ffi.C.kill(pid, SIGUSR1)
	end
end

local META_STATES = { pbeg = "play", prsm = "play", pfls = "pause", pend = "stop" }

-- The AirPlay slider sets the master volume: from the lowest step at the
-- bottom to airplay_max_db (state file, -40 dB unless set) at the top, so
-- a slider pushed up never blasts. At most one change every 100 ms.
local AIRPLAY_MAX_DB, AIRPLAY_RANGE_DB, VOLUME_MIN_DB, VOLUME_MS = -40, 30, -82, 100
local volume_want, volume_sent, volume_timer, volume_armed

local function volume_tick()
	volume_armed = false
	if volume_want and volume_want ~= volume_sent then
		volume_sent = volume_want
		call("mcu", "volume", { db = volume_want })
	end
end

local function airplay_volume(data)
	-- "airplay,volume,lowest,highest": the slider -30..0 dB, -144 muted
	local slider = tonumber(data:match("^([^,]+)"))
	if not slider then
		return
	end

	local top = tonumber(load_state().airplay_max_db or "") or AIRPLAY_MAX_DB
	top = top ~= top and AIRPLAY_MAX_DB or top > 0 and 0 or top < VOLUME_MIN_DB and VOLUME_MIN_DB or top
	slider = slider < -AIRPLAY_RANGE_DB and -AIRPLAY_RANGE_DB or slider > 0 and 0 or slider
	volume_want = math.floor(VOLUME_MIN_DB + (top - VOLUME_MIN_DB) *
				 (slider + AIRPLAY_RANGE_DB) / AIRPLAY_RANGE_DB + 0.5)
	volume_timer = volume_timer or uloop.timer(volume_tick)
	if not volume_armed then
		volume_armed = true
		volume_timer:set(VOLUME_MS)
	end
end

local function meta_item(kind, code, data)
	if kind == "core" and code == "minm" then
		track.title = data
	elseif kind == "core" and code == "asar" then
		track.artist = data
	elseif kind == "core" and code == "asal" then
		track.album = data
	elseif kind == "ssnc" and code == "pvol" then
		airplay_volume(data)
	elseif kind == "ssnc" and code == "mden" then
		show_track()
	elseif kind == "ssnc" and META_STATES[code] then
		-- a pause, skip or stop: what is queued is not wanted any more
		if code == "pfls" or code == "pend" then
			pcmd_flush()
		end
		-- a phone starts or resumes playing: the receiver goes to NET
		if META_STATES[code] == "play" and input_now ~= "network" then
			call("mcu", "input", { input = "net" })
		end
		if code == "pend" then
			track.title, track.artist, track.album = nil, nil, nil
		end
		track.state = META_STATES[code]
		show_track()
	end
end

local function unhex(h)
	return (h:gsub("%x%x", function(x) return string.char(tonumber(x, 16)) end))
end

local function meta_tick()
	if meta_fd < 0 then
		ffi.C.mkfifo(META_PIPE, tonumber("666", 8))
		-- read-write: no end of file while shairport-sync is not there
		meta_fd = ffi.C.open(META_PIPE, O_RDWR + O_NONBLOCK)
	end

	while meta_fd >= 0 do
		local n = tonumber(ffi.C.read(meta_fd, meta_chunk, 4096))
		if n <= 0 then
			break
		end
		meta_buf = meta_buf .. ffi.string(meta_chunk, n)
	end

	-- <item><type>hex</type><code>hex</code><length>n</length>[<data ...>b64</data>]</item>
	while true do
		local s, e = meta_buf:find("</item>", 1, true)
		if not s then
			break
		end
		local item = meta_buf:sub(1, e)
		meta_buf = meta_buf:sub(e + 1)
		local kind, code = item:match("<type>(%x+)</type><code>(%x+)</code>")
		if kind then
			meta_item(unhex(kind), unhex(code), base64(item:match("<data[^>]*>(.-)</data>") or ""))
		end
	end

	-- a stray partial item never grows without bound
	if #meta_buf > 65536 then
		meta_buf = ""
	end
	meta_timer:set(META_MS)
end

-- AC-3 layouts (acmod) as AudioApp tells the MCU: the source's channel
-- mask, and the count of front and rear channels for " 5.1"
local AC3_MASK = { [0] = 0x2000, 0x0002, 0x0005, 0x0007, 0x0025, 0x0027, 0x008D, 0x008F }
local AC3_FRONT = { [0] = 2, 1, 2, 3, 2, 3, 2, 3 }
local AC3_REAR = { [0] = 0, 0, 0, 0, 1, 1, 2, 2 }

-- liba52's layout names (dsp status "decoded") back to acmod
local AC3_NAMES = { ["1+1"] = 0, ["1/0"] = 1, ["2/0"] = 2, ["3/0"] = 3, ["2/1"] = 4,
		    ["3/1"] = 5, ["2/2"] = 6, ["3/2"] = 7 }

local function ac3_stream(acmod, lfe)
	local text = acmod == 0 and " 1+1" or
		     string.format(" %d.%d", AC3_FRONT[acmod] + AC3_REAR[acmod], lfe and 1 or 0)

	return { type = 3, input_mask = AC3_MASK[acmod], lfe = lfe, channels = text, format = 0x20 }
end

local handlers = {
	["dsp.ready"] = function()
		-- a restarted dspd has none of it: send it all again
		back_fill_now = nil

		-- nor does it decode anything yet: no Dolby left over
		if ac3_now then
			ac3_ca, ac3_now, stream_now = nil, nil, nil
			if c1_interface then
				set_input(c1_interface, nil, c1_channels)
			else
				stream_now = STREAM_PCM
				call("mcu", "stream", STREAM_PCM)
			end
		end
		local saved = load_state()

		log("DSP started again, setting it up")
		set_mode(mode_now, mode_name)
		set_tone(tonumber(saved.bass or ""), tonumber(saved.treble or ""))
		set_speakers(call("mcu", "status"))
		set_distances(distances_now or saved_distances(saved))
		call("dsp", "set", { input = input_now, fs = fs_now, lfe_level = lfe_pcm, av_sync = av_now,
				     late_night = late_now, loudness = loudness_now, dynamic_volume = adsy_now.dynamic_volume or 0,
				     meter = input_now == "network" })
		set_eq()
	end,
	-- DISPLAY on NET picked another mode: keep it
	["mcu.display"] = function(msg)
		save_state({ display = msg.mode })
	end,
	-- Dolby Digital decoded on the DSP: the MCU shows it, and with a centre or
	-- surrounds it plays as multichannel (2/0 stays stereo for the upmix)
	["dsp.bitstream"] = function(msg)
		local was = ac3_ca
		local acmod = tonumber(msg.acmod)

		if msg.decoded and acmod and AC3_MASK[acmod] then
			ac3_ca = acmod >= 3 and (AC3_REAR[acmod] > 0 and 0x0B or 0x00) or nil
			ac3_now = ac3_stream(acmod, msg.lfe == true or msg.lfe == 1)
			call("mcu", "stream", ac3_now)
		else
			ac3_ca = nil
			if ac3_now then
				-- back to what the last input report says
				ac3_now, stream_now = nil, nil
				if not c1_interface then
					stream_now = STREAM_PCM
					call("mcu", "stream", STREAM_PCM)
				end
			end
		end

		if c1_interface and (not stream_now or (ac3_ca ~= nil) ~= (was ~= nil)) then
			set_input(c1_interface, nil, c1_channels)
		end
	end,
	["mcu.ready"] = function(msg)
		set_model(msg)
		-- a restarted mcud starts from PCM
		if ac3_now or stream_now then
			call("mcu", "stream", ac3_now or stream_now)
		end
		set_display(load_state().display)
		show_track()
		set_usb()
	end,
	["mcu.update"] = function(msg)
		update(msg.stage)
	end,
	["osiris.media"] = function(msg)
		if msg.dir then
			set_media(msg.dir, msg.present)
		end
	end,
	["osiris.update"] = function(msg)
		set_bundle(msg.path, msg.version)
	end,
	["mcu.listening_mode"] = function(msg)
		-- the name can come without the MCU's byte, after a restart
		set_mode(msg.mode or mode_now, msg.name)
	end,
	["mcu.input"] = function(msg)
		if msg.interface then
			set_input(msg.interface, msg.fs, msg.channels)
		end
	end,
	["mcu.equalizer"] = function(msg)
		set_eq(msg.equalizer)
	end,
	["mcu.volume"] = function(msg)
		if msg.volume then
			volume_now = msg.volume
			set_loudness()
			-- the knob moved it: the next slider position counts again
			if volume_sent and msg.volume ~= volume_sent * 100 then
				volume_sent = nil
			end
		end
	end,
	["mcu.audyssey"] = function(msg)
		adsy_now = msg
		set_loudness()
		set_dynamic_volume()
	end,
	["mcu.late_night"] = function(msg)
		set_late_night(msg.dolby)
	end,
	["mcu.av_sync"] = function(msg)
		if msg.ms then
			set_av_sync(msg.ms)
		end
	end,
	["mcu.lfe_level"] = function(msg)
		set_lfe(msg.format, msg.level)
	end,
	["mcu.testtone"] = function(msg)
		testtone_ch = msg.channel or testtone_ch
		set_testtone()
	end,
	["mcu.tone"] = function(msg)
		set_tone(msg.bass, msg.treble)
	end,
	["mcu.distance"] = function(msg)
		set_distances(msg.distances)
	end,
	["mcu.speakers"] = function(msg)
		set_speakers(msg)
	end,
	["mcu.network"] = function()
		set_network()
	end,
	["mcu.power"] = function(msg)
		power(msg.state)
	end,
}

ffi.C.openlog(IDENT, LOG_PID, LOG_DAEMON)
uloop.init()
meta_timer = uloop.timer(meta_tick)
meta_timer:set(META_MS)
conn = ubus.connect()
if not conn then
	err("cannot connect to ubusd")
	os.exit(1)
end

-- The binding delivers events inside a running conn:call; a handler that
-- calls out would then run inside another one's call and crash LuaJIT.
-- Queue the events and handle them from the main loop.
local events, events_timer = {}
events_timer = uloop.timer(function()
	while #events > 0 do
		local ev = table.remove(events, 1)
		handlers[ev[1]](ev[2])
	end
end)

local queued = {}
for name in pairs(handlers) do
	queued[name] = function(msg)
		events[#events + 1] = { name, msg }
		events_timer:set(0)
	end
end
conn:listen(queued)
set_identity()
scan_media()

-- mcud may have finished its handshake before we started
local st = call("mcu", "status")
-- the MCU may have asked for updates before we listened
if st and st.update_check and bundle then
	call("mcu", "update", { available = true })
end

if st and st.stage == "ready" then
	set_model(st)
	set_usb()
end

local saved = load_state()
set_display(saved.display)
-- AC-3 decoded since before osirisd started: dspd only tells changes
local ds = call("dsp", "status")
if ds and ds.decoded then
	local name, lfe = ds.decoded:match("^([^.]+)%.(%d)$")
	if name and AC3_NAMES[name] then
		handlers["dsp.bitstream"]({ decoded = ds.decoded, acmod = AC3_NAMES[name], lfe = lfe == "1" })
	end
end
if st and (st.listening_mode or st.listening_mode_name) then
	set_mode(st.listening_mode, st.listening_mode_name)
else
	set_mode(tonumber(saved.listening_mode or ""), saved.listening_mode_name)
end
if st and st.bass then
	set_tone(st.bass, st.treble)
else
	set_tone(tonumber(saved.bass or ""), tonumber(saved.treble or ""))
end

set_speakers(st)
set_distances(st and st.distances or saved_distances(saved))
set_lfe("multichannel_pcm", tonumber(saved.lfe_multichannel_pcm or "") or 0)
if st and st.late_night then
	set_late_night(st.late_night)
end
if st and st.av_sync then
	set_av_sync(st.av_sync)
end
if st then
	volume_now = st.volume or volume_now
	adsy_now = { dynamic_eq = st.dynamic_eq, dynamic_eq_offset = st.dynamic_eq_offset,
		     dynamic_volume = st.dynamic_volume }
	set_loudness()
	set_dynamic_volume()
end
set_eq(saved_eq(saved))
set_eq(st and st.equalizer)
if st and st.interface then
	set_input(st.interface, st.fs, st.channels)
end

uloop.run()
